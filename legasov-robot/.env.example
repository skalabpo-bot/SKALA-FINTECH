# PLANTILLA — copia este archivo a .env y pon los valores reales ahí (.env lo ignora git).
# Los valores reales NUNCA van en este archivo (.env.example se sube al repo).

# Credenciales del panel admin de LegasovApp. OJO: el login es por NÚMERO DE DOCUMENTO, no correo.
LEGASOV_NUMERO_DOCUMENTO=tu_numero_de_documento
LEGASOV_PASSWORD=tu_contraseña

# Chrome remoto de Browserless (servicio de la plantilla de EasyPanel).
# Mismo Project → hostname interno "browserless". Sube el timeout (login+form puede pasar 30s).
# Ej: ws://browserless:3000?token=TU_TOKEN&timeout=90000
BROWSER_WS_ENDPOINT=ws://browserless:3000?token=TU_TOKEN&timeout=90000
# Protocolo: "cdp" (default, compatible) o "playwright" (endpoint /chromium/playwright de Browserless v2)
BROWSER_PROTOCOL=cdp

# Secreto compartido: la Edge Function de Skala manda este mismo valor en el header X-Robot-Secret.
# Genera uno largo y aleatorio (ej. openssl rand -hex 32).
ROBOT_SECRET=cambia_esto_por_un_secreto_largo_aleatorio

# Puerto del servicio (EasyPanel lo mapea al dominio)
PORT=3000

# Base del panel (por si cambia el dominio)
LEGASOV_BASE=https://legasovapp.com
