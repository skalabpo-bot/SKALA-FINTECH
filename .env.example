# Copiar a .env.local y rellenar con valores reales (desarrollo local SOLO)

# Supabase URL y Anon Key (públicas — OK en bundle)
VITE_SUPABASE_URL=https://yfosumpmtmcomfpbspaz.supabase.co
VITE_SUPABASE_ANON_KEY=<obtener de Supabase Project Settings > API>

# ⛔️ NUNCA en variables VITE_*:
# - Service role key (rol=service_role, bypassa RLS completamente)
# - API keys de IA (Gemini, OpenAI, etc.) — se compilan en el bundle público
#
# Qué hacer en su lugar:
# 1. Service role operations → Edge Function admin-users (servidor)
# 2. IA operations (OCR) → Edge Function analyze-document (servidor)
# 3. Las Edge Functions leen sus keys desde Supabase secrets (protegido)

# Desarrollo local: si necesitas probar con las keys, usalas SOLO en Supabase secrets
# y no las setees aquí. Las Edge Functions las encontrarán vía Deno.env.get()
